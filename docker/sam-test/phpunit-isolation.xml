<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="/var/www/html/vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="/var/www/html/vendor/autoload.php"
         cacheDirectory="/var/www/html/storage/framework/cache/phpunit"
         colors="true">
    <testsuites>
        <testsuite name="Isolation">
            <file>/opt/sam-test/IsolatedDatabaseConnectionTest.php</file>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_HOST" value="mysql" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_DATABASE" value="lextrack_sam_test" force="true"/>
        <env name="DB_USERNAME" value="lextrack_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
    </php>
</phpunit>
