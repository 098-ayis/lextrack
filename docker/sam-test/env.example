# Copy this file to .env.sam-test in the repository root. Do not commit that file.
# Generate both passwords and the application key locally before starting Compose.
SAM_TEST_DB_ROOT_PASSWORD=replace-with-a-random-password
SAM_TEST_DB_PASSWORD=replace-with-a-different-random-password
SAM_TEST_APP_KEY=base64:replace-with-a-random-32-byte-key
