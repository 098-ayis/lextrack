# Non-secret Compose settings. Keep the real .env.production outside source control.
# APP_KEY, DB_PASSWORD, and MYSQL_ROOT_PASSWORD are Docker secret files, not
# environment variables. Create those files only during controlled provisioning.
APP_NAME=LexTrack
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:10000
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
DB_DATABASE=lextrack
DB_USERNAME=lextrack
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
FILESYSTEM_DISK=local
DOCUMENT_FILESYSTEM_DISK=local
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_EXPIRE_ON_CLOSE=false
SESSION_PATH=/
SESSION_DOMAIN=
INACTIVITY_TIMEOUT=60
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
SESSION_COOKIE=lextrack_session
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_URL=
MAIL_EHLO_DOMAIN=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="LexTrack Legal Office"
GOOGLE_REDIRECT_URI=https://lextrack.example.invalid/auth/google/callback
OPENAI_URL=https://api.openai.com/v1
OPENAI_STORE=true
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_API_KEY=
AZURE_OPENAI_URL=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-1
AZURE_OPENAI_STORE=true
OPENAI_COMPATIBLE_URL=
LEXTRACK_IMAGE_TAG=phase2-2026-11
LEXTRACK_SECRETS_DIR=/opt/lextrack/secrets
LEXTRACK_WEB_BIND=0.0.0.0:10000
LOG_LEVEL=info

# The production Compose project is intentionally isolated from the regular
# Sail and SAM test projects. Keep these names and the 10000 host port unique
# to this deployment.
# Production data persists in the lextrack-production-* named volumes:
# MySQL, private documents, public uploads, and chatbot knowledge.

# Set these only in the untracked .env.production file or through a secret
# management system. Do not commit credentials or API keys.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OPENAI_API_KEY=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# AZURE_OPENAI_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=

# Offline demonstration: the core web/database/queue/scheduler stack works
# without internet access. Google OAuth, SMTP/API mail, Turnstile, OpenAI, and
# the holiday feed need their external services. Chatbot AI can use an Ollama
# instance on the Ubuntu host through OLLAMA_URL, or OpenAI when configured.
