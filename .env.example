APP_NAME=LexTrack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# For Aiven MySQL, set DB_CONNECTION=mysql and use the host, port, database,
# username, and password shown in Aiven Console. Store the downloaded Aiven CA
# as a Render Secret File and point MYSQL_ATTR_SSL_CA to its absolute path.
# MYSQL_ATTR_SSL_CA=/etc/secrets/aiven-ca.pem
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true

SESSION_DRIVER=database
SESSION_LIFETIME=60
INACTIVITY_TIMEOUT=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Render: set SESSION_SECURE_COOKIE=true because Render terminates HTTPS at the proxy.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
DOCUMENT_FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="LexTrack Legal Office"
# Render Free blocks common outbound SMTP ports. For production mail, prefer
# an HTTPS API mailer such as Resend or Postmark:
# MAIL_MAILER=resend
# RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# For private Backblaze B2 on Render, set DOCUMENT_FILESYSTEM_DISK=s3 and use:
# AWS_ACCESS_KEY_ID=<bucket-scoped B2 key ID>
# AWS_SECRET_ACCESS_KEY=<bucket-scoped B2 application key>
# AWS_DEFAULT_REGION=<B2 bucket region, e.g. us-east-005>
# AWS_BUCKET=<private B2 bucket name>
# AWS_ENDPOINT=https://s3.<region>.backblazeb2.com
# AWS_USE_PATH_STYLE_ENDPOINT=true

# Cloudflare Turnstile test keys for local development.
# Replace both with your production keys before deploying.
TURNSTILE_SITE_KEY=3x00000000000000000000FF
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

VITE_APP_NAME="${APP_NAME}"
